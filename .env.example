# Database
DATABASE_URL=postgresql+asyncpg://gridpilot:gridpilot@localhost:5432/gridpilot

# Rolling horizon (PRD.md §4, §14)
TICK_INTERVAL_MINUTES=60
HORIZON_HOURS=24
SOLVE_TIMEOUT_SECONDS=20

# Forecast provider — Open-Meteo is key-less by design (PRD.md §4, NFR-6)
FORECAST_PROVIDER=openmeteo

# Dispatch target for the current tier — see PRD.md §9
DISPATCH_ADAPTER=simulator   # simulator | hardware ([DESIGN])

# Dashboard (Next.js reads NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# The site this backend instance runs when none is specified
DEFAULT_SITE_ID=example-site
