# Database
DATABASE_URL=postgresql+asyncpg://gridpilot:gridpilot@localhost:5432/gridpilot

# Rolling horizon (PRD.md §4, §14)
TICK_INTERVAL_MINUTES=60
HORIZON_HOURS=24
SOLVE_TIMEOUT_SECONDS=20

# Forecast provider — Open-Meteo is key-less by design (PRD.md §4, NFR-6)
FORECAST_PROVIDER=openmeteo

# Dispatch target for the current tier — see PRD.md §9
DISPATCH_ADAPTER=simulator   # simulator | hardware ([DESIGN])

# Dashboard (Next.js reads NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only — used by dashboard/app/api/[...path]/route.ts (the BFF), never sent to the browser.
# Same value as NEXT_PUBLIC_API_URL in dev; kept separate so a containerized dashboard can reach
# the backend by its service name (e.g. http://backend:8000) without also changing the public one.
BACKEND_URL=http://localhost:8000

# The site this backend instance runs when none is specified — must equal the `name:` field in
# optimizer/sites/example-site.yml (see backend/src/config/settings.py's comment on this).
DEFAULT_SITE_ID=Dharavi Microgrid
